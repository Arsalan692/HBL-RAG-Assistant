# HBL RAG Assistant — backend configuration
#
# Copy to backend/.env and edit. The real .env is gitignored and stays on the
# machine it describes: the laptop and the GPU workstation want different
# values, and neither should be committed.
#
# Every value below is a default already baked into app/config.py. Uncomment
# only what you need to change — a .env that repeats the defaults just becomes
# another place for them to drift.

# --- Runtime ------------------------------------------------------------------
# HBL_APP_ENV=dev
# HBL_LOG_LEVEL=INFO
# HBL_LOG_FORMAT=console        # console | json  (json for unattended ingest runs)
# HBL_DEVICE=auto               # auto | cuda | cpu
# HBL_TORCH_DTYPE=float16
# HBL_HF_OFFLINE=true           # never let a library fetch weights as a side effect

# --- Paths --------------------------------------------------------------------
# Relative paths are anchored to the repository root, so they mean the same
# thing on both machines. Everything under them is gitignored — parsed markdown,
# page images and the vector index all carry the source documents' content.
# HBL_DATA_DIR=data
# HBL_STORAGE_DIR=storage
#
# On the GPU workstation these should point OUTSIDE the working copy. That
# machine is re-cloned rather than pulled, so anything inside it is deleted with
# the old clone -- including data/parsed/, which is about 55 minutes of GPU
# extraction, and the index. Absolute paths are left alone by the config.
#
# Set them as Windows user environment variables rather than here, because this
# file is gitignored and dies with the clone too:
#   setx HBL_DATA_DIR     "D:\hbl-data"
#   setx HBL_STORAGE_DIR  "D:\hbl-storage"
# HBL_DOCUMENTS_DIR=data/documents
# HBL_PARSED_DIR=data/parsed
# HBL_PAGE_IMAGE_DIR=data/page_images
# HBL_REGISTRY_DB=storage/registry.sqlite
# HBL_QDRANT_DIR=storage/qdrant
# HBL_MODEL_CACHE_DIR=storage/models

# --- Generation ---------------------------------------------------------------
# Served by Ollama on this machine. The base URL is validated: it must resolve
# to loopback or the local network, never a public host.
# HBL_LLM_PROVIDER=ollama
# HBL_LLM_MODEL=qwen3:14b
# HBL_LLM_BASE_URL=http://127.0.0.1:11434
# HBL_LLM_TEMPERATURE=0.1
# HBL_LLM_MAX_OUTPUT_TOKENS=1024
# HBL_LLM_CONTEXT_TOKENS=8192
# HBL_LLM_KEEP_ALIVE=30m
# HBL_LLM_THINK=false           # Qwen3's <think> block costs seconds before the
                                # first visible word. Leave off unless comparing.
#
# Covers a SINGLE read, and the first read is the expensive one: Ollama loads
# the weights and prefills the whole prompt before emitting a token. On a
# CPU-only machine that can pass 180s while the same request takes seconds once
# the model is resident -- so a cold first question raises and the second
# succeeds. Warm it once with `ollama run qwen3:8b ""` rather than raising this.
# HBL_LLM_TIMEOUT_S=180
#
# Start loading the weights alongside retrieval rather than after it. Unset
# means "decide from HBL_DEVICE", and the two devices want opposite answers:
#   cuda -> on.  The VRAM budget already assumes all three models are resident,
#           the load is quick, and the overlap is free time off the first token.
#   cpu  -> off. Warming makes the LLM's ~4.9 GB resident *while* the embedder
#           and reranker are working. On a 16 GB laptop with a browser open
#           that peak segfaults the process -- observed twice. Serialising
#           costs a cold start instead, which is what TIMEOUT_S must absorb.
# Set it explicitly only if your machine disagrees with that default.
# HBL_LLM_WARM_AHEAD=

# --- Dense retrieval ----------------------------------------------------------
# On the air-gapped workstation the model name is a LOCAL PATH, not a repo id —
# nothing may reach huggingface.co at load time. Relative paths anchor to the
# repository root, same as every other path here.
# Two routes to the same model. Prefer `ollama` unless there is a reason not to:
# Ollama is already installed and already holds bge-m3, so it needs no torch,
# no sentence-transformers and no weights folder carried across — about 4.6 GB
# of transfer avoided. The `bge-m3` provider loads the weights in-process
# instead, and is there for when that is wanted.
# HBL_EMBEDDING_PROVIDER=ollama
# HBL_EMBEDDING_MODEL=bge-m3
# HBL_EMBEDDING_BASE_URL=http://127.0.0.1:11434   # validated local, as above
#
# The in-process route. The model name is a LOCAL PATH here, not a repo id —
# nothing may reach huggingface.co at load time on the air-gapped machine.
# HBL_EMBEDDING_PROVIDER=bge-m3
# HBL_EMBEDDING_MODEL=storage/models/bge-m3
# HBL_EMBEDDING_DIMENSION=1024    # bge-m3's own hidden size; changing it means a re-index
# HBL_EMBEDDING_MAX_LENGTH=2048   # must clear the largest chunk, or its tail is never searchable
#
# Note: bge-m3 ships its weights as pytorch_model.bin, NOT model.safetensors.
# Stage these ten files and nothing else -- the repo also carries ~2 GB of ONNX
# exports and a ColBERT head that sentence-transformers never loads:
#   pytorch_model.bin  config.json  config_sentence_transformers.json
#   modules.json  sentence_bert_config.json  sentencepiece.bpe.model
#   special_tokens_map.json  tokenizer.json  tokenizer_config.json
#   1_Pooling/config.json
# HBL_EMBEDDING_BATCH_SIZE=8

# --- Reranking ----------------------------------------------------------------
# The cross-encoder that cuts the fused candidates down to what reaches the
# model. There is no Ollama route for this one — Ollama has no rerank endpoint —
# so torch is required on whichever machine runs it.
#
# Unlike bge-m3, this repo ships model.safetensors (not pytorch_model.bin) and
# carries no ONNX exports, so a plain download needs no --include/--exclude:
#   hf download BAAI/bge-reranker-v2-m3 --local-dir D:\transfer\bge-reranker-v2-m3
#
# Point this at that folder. A repo id with HBL_HF_OFFLINE=true will not
# download; it raises, naming the command above.
# HBL_RERANKER_PROVIDER=bge-reranker-v2-m3
# HBL_RERANKER_MODEL=storage/models/bge-reranker-v2-m3
# HBL_RERANKER_MAX_LENGTH=1024
# HBL_RERANKER_BATCH_SIZE=8

# --- Page recognition ---------------------------------------------------------
# Settled 2026-08-21 by `hbl bench` over five real pages. These are the
# defaults; uncomment only to change them.
# HBL_OCR_PROVIDER=vlm
# HBL_OCR_MODEL=qwen2.5vl:7b
# HBL_OCR_BASE_URL=http://127.0.0.1:11434    # validated local, as above
# HBL_OCR_LANGUAGES=en
# HBL_OCR_DPI=300
#
# Do not swap the model without re-running the bench. On a dense ruled table
# qwen2.5vl:3b silently corrupted cells — one Exclusions value vanished and
# another was replaced — while producing a table that looked perfectly
# well-formed and scored identically on every automatic measure. glm-ocr:latest
# read the same table correctly but looped on a sparse title page, repeating
# four lines 115 times.
#
#   hbl bench --engines vlm=qwen2.5vl:7b vlm=qwen2.5vl:3b vlm=glm-ocr:latest

# --- Page routing -------------------------------------------------------------
# Thresholds for the per-page DIGITAL / SCANNED / HYBRID decision. The defaults
# were read off the real corpus with `app.cli classify`, not guessed — character
# density there is sharply bimodal (p25 = 1.2, median 24.5, p75 = 33.0), so the
# cutoff sits in the empty gap between the two modes. For scale, A4 is 96.7 in²
# and a full page of body prose measures about 30 characters per square inch.
# HBL_INGEST_MIN_CHAR_DENSITY=12
# HBL_INGEST_EMPTY_CHAR_DENSITY=3
# HBL_INGEST_RASTER_THRESHOLD=0.20
# HBL_INGEST_MAX_GARBLE=0.45
# HBL_INGEST_RENDER_DPI=300
#
# Leave this off. Roughly 220 pages of this corpus are scans that arrived with
# someone else's OCR already on them, and that text can measure perfectly
# healthy while being wrong — one page renders the HBL logo as "MBL HA.aH3GANK".
# Turning it on skips re-reading those pages and trusts what is there.
# HBL_INGEST_TRUST_PRIOR_OCR=false

# --- Retrieval ----------------------------------------------------------------
# HBL_RETRIEVAL_DENSE_TOP_K=30
# HBL_RETRIEVAL_KEYWORD_TOP_K=30
# HBL_RETRIEVAL_RRF_K=60
# HBL_RETRIEVAL_RERANK_CANDIDATES=30   # lower = faster answers, cheapest speed knob
# HBL_RETRIEVAL_RERANK_TOP_K=8
#
# Below this reranker score, retrieval returns NOTHING and the answer must be a
# refusal. It is a probability, not a similarity — raising it makes the system
# admit ignorance more often, lowering it makes it answer from weaker material.
# HBL_RETRIEVAL_MIN_RERANK_SCORE=0.15
# HBL_RETRIEVAL_QDRANT_COLLECTION=hbl_chunks
#
# Older vintages are marked and ranked last, never dropped: where a 2023 and a
# 2025 edition genuinely differ, that difference is usually the answer.
# HBL_RETRIEVAL_PREFER_NEWEST_VINTAGE=true

# --- API ----------------------------------------------------------------------
# `hbl serve` runs it. Single worker on purpose: each worker would load its own
# bge-m3 and reranker -- 4.6 GB apiece -- and then compete for one GPU.
# Requests are serialised inside the process instead.
#
# CORS is a real boundary here, not boilerplate. The corpus is confidential and
# this port answers questions about it, so a wildcard would let any page open
# in the browser read bank policy. Keep it to the origins you actually serve.
# HBL_API_HOST=127.0.0.1
# HBL_API_PORT=8000
# HBL_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
